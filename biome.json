{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!dist", "!node_modules", "!**/*.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/engine/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react-dom",
                      "react/**",
                      "**/drama/**",
                      "**/scenarios/**",
                      "**/ui/**"
                    ],
                    "message": "engine はどの層にも依存しない（docs/05 §2.1）"
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "engine では DOM を使わない",
                  "document": "engine では DOM を使わない",
                  "localStorage": "engine では DOM を使わない",
                  "sessionStorage": "engine では DOM を使わない",
                  "navigator": "engine では DOM を使わない"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/drama/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["react", "react-dom", "react/**", "**/scenarios/**", "**/ui/**"],
                    "message": "drama は engine（型のみ）にだけ依存する（docs/05 §2.1）"
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "drama では DOM を使わない",
                  "document": "drama では DOM を使わない",
                  "localStorage": "drama では DOM を使わない",
                  "sessionStorage": "drama では DOM を使わない",
                  "navigator": "drama では DOM を使わない"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/scenarios/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["react", "react-dom", "react/**", "**/ui/**"],
                    "message": "scenarios は engine と drama にだけ依存する（docs/05 §2.1）"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
